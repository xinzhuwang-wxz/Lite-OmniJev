{
  "schema_version": 1,
  "status": "candidate_shadow_not_release_gate",
  "cohort_for_selection": "parity-fixture-v1/calibration",
  "cohort_for_confirmation": "parity-fixture-v1/confirmation",
  "dtype": "float16",
  "backend": "TRITON_ATTN",
  "requirements": {
    "complete_identity_and_provenance": true,
    "finite_complete_raw_probabilities": true,
    "joint_top_answer_set_changes_max": 0,
    "joint_accuracy_degradation_max": 0.0,
    "mean_joint_TV_max": 0.002,
    "p95_joint_TV_max": 0.01,
    "joint_brier_degradation_max": 0.005,
    "known_target_ece15_degradation_per_type_max": 0.005
  },
  "manual_review_triggers": {
    "any_joint_TV_above": 0.01,
    "any_normalized_expected_score_delta_above": 0.01,
    "any_conditional_top_answer_set_change": true
  },
  "outcomes": ["reject", "review_required", "shadow_supported"],
  "release_or_stage_acceptance": false,
  "confirmation_must_be_complete_no_posthoc_filtering": true,
  "policy_changes_after_confirmation_require_new_independent_cohort": true
}
